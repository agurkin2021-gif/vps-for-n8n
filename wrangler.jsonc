{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vps-for-n8n",
  "main": "./cloudflare-worker.mjs",
  "compatibility_date": "2026-10-19",
  "build": {
    "command": "node cloudflare-build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "vpsforn8n.com",
      "custom_domain": true
    },
    {
      "pattern": "www.vpsforn8n.com/*",
      "zone_name": "vpsforn8n.com"
    }
  ]
}
